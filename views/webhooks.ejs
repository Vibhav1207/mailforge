<%- include('partials/head', { title: 'Webhooks' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-plug"></i> Webhooks</h2>
  <button class="btn btn-primary" onclick="openModal('createWebhookModal')"><i class="fas fa-plus"></i> Create Webhook</button>
</div>

<div class="card animate-in delay-1">
  <div class="card-body" style="padding: 0;">
    <% if (webhooks.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-plug"></i>
      <h3>No Webhooks</h3>
      <p>Configure webhooks to receive real-time notifications about email events.</p>
      <button class="btn btn-primary" onclick="openModal('createWebhookModal')"><i class="fas fa-plus"></i> Create Webhook</button>
    </div>
    <% } else { %>
    <div class="table-wrap" style="border: none; border-radius: 0;">
      <table>
        <thead><tr><th>Name</th><th>URL</th><th>Events</th><th>Status</th><th>Created</th><th>Actions</th></tr></thead>
        <tbody>
          <% webhooks.forEach(function(h) { %>
          <tr>
            <td><strong><%= h.name %></strong></td>
            <td><code style="font-size: 0.75rem;"><%= h.url.length > 40 ? h.url.slice(0,40) + '...' : h.url %></code></td>
            <td>
              <% h.events.forEach(function(ev) { %>
              <span class="badge badge-info" style="margin-right: 0.2rem;"><%= ev %></span>
              <% }); %>
            </td>
            <td><span class="badge badge-<%= h.enabled ? 'success' : 'danger' %>"><%= h.enabled ? 'Active' : 'Disabled' %></span></td>
            <td><%= formatDate(h.created_at) %></td>
            <td style="display: flex; gap: 0.4rem;">
              <form method="POST" action="/webhooks/<%= h._id %>/test" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm" title="Test"><i class="fas fa-play"></i></button>
              </form>
              <form method="POST" action="/webhooks/<%= h._id %>/toggle" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm" title="Toggle"><i class="fas fa-power-off"></i></button>
              </form>
              <form method="POST" action="/webhooks/<%= h._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete?')">
                <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--danger);" title="Delete"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Create Webhook Modal -->
<div class="modal-overlay" id="createWebhookModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Create Webhook</span>
      <button class="modal-close" onclick="closeModal('createWebhookModal')">&times;</button>
    </div>
    <form method="POST" action="/webhooks/create">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Name</label>
          <input type="text" name="name" class="form-control" placeholder="My Webhook">
        </div>
        <div class="form-group">
          <label class="form-label">URL</label>
          <input type="url" name="url" class="form-control" placeholder="https://yourapp.com/webhooks/mailforge" required>
        </div>
        <div class="form-group">
          <label class="form-label">Events</label>
          <div style="display: flex; flex-wrap: wrap; gap: 0.75rem;">
            <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; cursor: pointer;">
              <input type="checkbox" name="events" value="email.sent"> email.sent
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; cursor: pointer;">
              <input type="checkbox" name="events" value="email.delivered" checked> email.delivered
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; cursor: pointer;">
              <input type="checkbox" name="events" value="email.failed"> email.failed
            </label>
            <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; cursor: pointer;">
              <input type="checkbox" name="events" value="email.bounced"> email.bounced
            </label>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('createWebhookModal')">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Create Webhook</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
