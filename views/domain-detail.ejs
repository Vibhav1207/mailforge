<%- include('partials/head', { title: domain.domain }) %>

<div class="page-header animate-in">
  <div>
    <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.25rem;">
      <a href="/domains" style="color: var(--text-muted); font-size: 0.85rem;"><i class="fas fa-arrow-left"></i> Domains</a>
      <span class="badge badge-<%= domain.status === 'verified' ? 'success' : domain.status === 'failed' ? 'danger' : 'info' %>">
        <% if (domain.status === 'verified') { %>✓ Verified<% } else if (domain.status === 'verifying') { %>⏳ Verifying<% } else if (domain.status === 'failed') { %>✗ Failed<% } else { %>Pending<% } %>
      </span>
    </div>
    <h2 class="page-title" style="margin-bottom: 0;"><%= domain.domain %></h2>
  </div>
  <div style="display: flex; gap: 0.5rem;">
    <form method="POST" action="/domains/<%= domain._id %>/verify" style="display: inline;">
      <button type="submit" class="btn btn-primary"><i class="fas fa-check-circle"></i> Verify Domain</button>
    </form>
    <form method="POST" action="/domains/<%= domain._id %>/delete" style="display: inline;" onsubmit="return confirm('Delete this domain?')">
      <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></button>
    </form>
  </div>
</div>

<!-- DNS Records -->
<div class="card animate-in delay-1">
  <div class="card-header">
    <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-database" style="color: var(--accent); margin-right: 0.5rem;"></i> DNS Records</h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1rem;">Add these DNS records to your domain provider to verify ownership and enable email sending.</p>

    <!-- Verification TXT -->
    <div class="dns-record-group">
      <div class="dns-label">Verification TXT Record</div>
      <div class="dns-record-row">
        <div class="dns-field"><span class="dns-field-label">Type</span><span class="dns-field-value">TXT</span></div>
        <div class="dns-field"><span class="dns-field-label">Host</span><span class="dns-field-value">@</span></div>
        <div class="dns-field" style="flex: 2;"><span class="dns-field-label">Value</span>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="dns-field-value" style="word-break: break-all;"><%= domain.dns_records ? domain.dns_records.verification : '' %></span>
            <button class="btn btn-ghost btn-sm" onclick="copyToClipboard('<%= domain.dns_records ? domain.dns_records.verification : '' %>', this)"><i class="fas fa-copy"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- SPF -->
    <div class="dns-record-group">
      <div class="dns-label">SPF Record</div>
      <div class="dns-record-row">
        <div class="dns-field"><span class="dns-field-label">Type</span><span class="dns-field-value">TXT</span></div>
        <div class="dns-field"><span class="dns-field-label">Host</span><span class="dns-field-value">@</span></div>
        <div class="dns-field" style="flex: 2;"><span class="dns-field-label">Value</span>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="dns-field-value"><%= domain.dns_records ? domain.dns_records.spf : '' %></span>
            <button class="btn btn-ghost btn-sm" onclick="copyToClipboard('<%= domain.dns_records ? domain.dns_records.spf : '' %>', this)"><i class="fas fa-copy"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- DKIM -->
    <div class="dns-record-group">
      <div class="dns-label">DKIM Record</div>
      <div class="dns-record-row">
        <div class="dns-field"><span class="dns-field-label">Type</span><span class="dns-field-value">TXT</span></div>
        <div class="dns-field"><span class="dns-field-label">Host</span><span class="dns-field-value"><%= domain.dkim_selector %>.<%= domain.domain %></span></div>
        <div class="dns-field" style="flex: 2;"><span class="dns-field-label">Value</span>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="dns-field-value" style="word-break: break-all; font-size: 0.75rem;"><%= domain.dns_records ? domain.dns_records.dkim : '' %></span>
            <button class="btn btn-ghost btn-sm" onclick="copyToClipboard('<%= domain.dns_records ? domain.dns_records.dkim : '' %>', this)"><i class="fas fa-copy"></i></button>
          </div>
        </div>
      </div>
    </div>

    <!-- DMARC -->
    <div class="dns-record-group">
      <div class="dns-label">DMARC Record</div>
      <div class="dns-record-row">
        <div class="dns-field"><span class="dns-field-label">Type</span><span class="dns-field-value">TXT</span></div>
        <div class="dns-field"><span class="dns-field-label">Host</span><span class="dns-field-value">_dmarc.<%= domain.domain %></span></div>
        <div class="dns-field" style="flex: 2;"><span class="dns-field-label">Value</span>
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <span class="dns-field-value"><%= domain.dns_records ? domain.dns_records.dmarc : '' %></span>
            <button class="btn btn-ghost btn-sm" onclick="copyToClipboard('<%= domain.dns_records ? domain.dns_records.dmarc : '' %>', this)"><i class="fas fa-copy"></i></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Sender Identities -->
<div class="card animate-in delay-2" style="margin-top: 1rem;">
  <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
    <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-at" style="color: var(--accent); margin-right: 0.5rem;"></i> Sender Identities</h3>
    <button class="btn btn-primary btn-sm" onclick="openModal('addIdentityModal')"><i class="fas fa-plus"></i> Add Sender</button>
  </div>
  <div class="card-body" style="padding: 0;">
    <% if (identities.length === 0) { %>
    <div class="empty-state" style="padding: 2rem;">
      <p>No sender identities yet. Create one to start sending from this domain.</p>
    </div>
    <% } else { %>
    <div class="table-wrap" style="border: none; border-radius: 0;">
      <table>
        <thead><tr><th>Email</th><th>Display Name</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% identities.forEach(function(ident) { %>
          <tr>
            <td><strong><%= ident.email %></strong></td>
            <td><%= ident.display_name %></td>
            <td><span class="badge badge-<%= ident.enabled ? 'success' : 'danger' %>"><%= ident.enabled ? 'Enabled' : 'Disabled' %></span></td>
            <td style="display: flex; gap: 0.4rem;">
              <form method="POST" action="/identities/<%= ident._id %>/toggle" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm"><i class="fas fa-power-off"></i></button>
              </form>
              <form method="POST" action="/identities/<%= ident._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete?')">
                <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--danger);"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Add Identity Modal -->
<div class="modal-overlay" id="addIdentityModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add Sender Identity</span>
      <button class="modal-close" onclick="closeModal('addIdentityModal')">&times;</button>
    </div>
    <form method="POST" action="/identities/add">
      <div class="modal-body">
        <input type="hidden" name="domain_id" value="<%= domain._id %>">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="hello@<%= domain.domain %>" required>
        </div>
        <div class="form-group">
          <label class="form-label">Display Name</label>
          <input type="text" name="display_name" class="form-control" placeholder="My Business">
        </div>
        <div class="form-group">
          <label class="form-label">Reply-To (optional)</label>
          <input type="email" name="reply_to" class="form-control" placeholder="support@<%= domain.domain %>">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('addIdentityModal')">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Create Sender</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
