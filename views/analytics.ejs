<%- include('partials/head', { title: 'Analytics' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-chart-bar"></i> Analytics</h2>
</div>

<!-- Stats Cards -->
<div class="stats-grid animate-in delay-1">
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(45,212,168,0.12); color: var(--accent);"><i class="fas fa-envelope"></i></div>
    <div><div class="stat-value"><%= total %></div><div class="stat-label">Total Sent</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(54,201,142,0.12); color: var(--success);"><i class="fas fa-check-circle"></i></div>
    <div><div class="stat-value"><%= delivered %></div><div class="stat-label">Delivered</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(244,112,103,0.12); color: var(--danger);"><i class="fas fa-times-circle"></i></div>
    <div><div class="stat-value"><%= failed %></div><div class="stat-label">Failed</div></div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background: rgba(100,181,246,0.12); color: var(--info);"><i class="fas fa-chart-line"></i></div>
    <div><div class="stat-value"><%= deliveryRate %>%</div><div class="stat-label">Delivery Rate</div></div>
  </div>
</div>

<!-- 30-Day Chart -->
<div class="card animate-in delay-2" style="margin-top: 1rem;">
  <div class="card-header">
    <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-chart-bar" style="color: var(--accent); margin-right: 0.5rem;"></i> Emails — Last 30 Days</h3>
  </div>
  <div class="card-body">
    <div class="chart-bars" style="overflow-x: auto;">
      <% var maxSent = Math.max(...dailyStats.map(function(d) { return d.sent; }), 1); %>
      <% dailyStats.forEach(function(d) { %>
      <div class="chart-bar-col" style="min-width: 22px;">
        <div class="chart-bar-wrap">
          <div class="chart-bar" style="height: <%= Math.round((d.sent / maxSent) * 100) %>%;">
            <span class="chart-bar-value"><%= d.sent %></span>
          </div>
        </div>
        <span class="chart-bar-label" style="font-size: 0.6rem;"><%= d.date %></span>
      </div>
      <% }); %>
    </div>
  </div>
</div>

<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem;">
  <!-- Top Senders -->
  <div class="card animate-in delay-3">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-user" style="color: var(--accent); margin-right: 0.5rem;"></i> Top Senders</h3>
    </div>
    <div class="card-body" style="padding: 0;">
      <% if (topSenders.length === 0) { %>
      <div class="empty-state" style="padding: 1.5rem;"><p style="color: var(--text-muted);">No data yet</p></div>
      <% } else { %>
      <table>
        <thead><tr><th>Sender</th><th>Count</th></tr></thead>
        <tbody>
          <% topSenders.forEach(function(s) { %>
          <tr>
            <td><%= s._id %></td>
            <td><strong><%= s.count %></strong></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- Breakdown -->
  <div class="card animate-in delay-4">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-pie-chart" style="color: var(--accent); margin-right: 0.5rem;"></i> Status Breakdown</h3>
    </div>
    <div class="card-body">
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.3rem;">
            <span>Delivered</span><span style="color: var(--success); font-weight: 600;"><%= delivered %></span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width: <%= total > 0 ? Math.round(delivered/total*100) : 0 %>%; background: var(--success);"></div></div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.3rem;">
            <span>Failed</span><span style="color: var(--danger); font-weight: 600;"><%= failed %></span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width: <%= total > 0 ? Math.round(failed/total*100) : 0 %>%; background: var(--danger);"></div></div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.3rem;">
            <span>Bounced</span><span style="color: var(--warning); font-weight: 600;"><%= bounced %></span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width: <%= total > 0 ? Math.round(bounced/total*100) : 0 %>%; background: var(--warning);"></div></div>
        </div>
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 0.82rem; margin-bottom: 0.3rem;">
            <span>Queued</span><span style="color: var(--info); font-weight: 600;"><%= queued %></span>
          </div>
          <div class="progress-bar-wrap"><div class="progress-bar-fill" style="width: <%= total > 0 ? Math.round(queued/total*100) : 0 %>%; background: var(--info);"></div></div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
