<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login — MailForge</title>
  <link rel="stylesheet" href="/public/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="card">
      <div class="card-body">
        <div class="auth-brand">
          <h1><i class="fas fa-bolt"></i> MailForge</h1>
          <p>Developer Email Infrastructure</p>
        </div>

        <% if (typeof flash !== 'undefined' && flash && flash.message) { %>
        <div class="alert alert-<%= flash.type === 'danger' ? 'warning' : 'info' %>">
          <i class="fas fa-<%= flash.type === 'danger' ? 'exclamation-triangle' : 'info-circle' %>"></i>
          <%= flash.message %>
        </div>
        <% } %>

        <div style="text-align: center; margin-bottom: 1.5rem;">
          <h2 style="font-size: 1.1rem; font-weight: 600;">Sign In</h2>
        </div>

        <!-- Login Form -->
        <form id="loginForm" class="auth-form active" method="POST" action="/login">
          <div class="form-group">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" placeholder="you@company.com" required>
          </div>
          <div class="form-group">
            <label class="form-label">Password</label>
            <div class="pw-wrap">
              <input type="password" name="password" id="loginPw" class="form-control" placeholder="••••••••" required>
              <button type="button" class="pw-toggle" onclick="togglePw('loginPw')"><i class="fas fa-eye"></i></button>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg">
            <i class="fas fa-sign-in-alt"></i> Sign In
          </button>
        </form>


      </div>
    </div>
  </div>
</div>

<script>
function togglePw(id) {
  var el = document.getElementById(id);
  var icon = el.nextElementSibling.querySelector('i');
  if (el.type === 'password') { el.type = 'text'; icon.className = 'fas fa-eye-slash'; }
  else { el.type = 'password'; icon.className = 'fas fa-eye'; }
}
</script>
</body>
</html>
