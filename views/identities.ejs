<%- include('partials/head', { title: 'Sender Identities' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-at"></i> Sender Identities</h2>
  <button class="btn btn-primary" onclick="openModal('addIdentityModal')" <%= domains.length === 0 ? 'disabled' : '' %>><i class="fas fa-plus"></i> Add Sender</button>
</div>

<% if (domains.length === 0) { %>
<div class="card animate-in delay-1">
  <div class="empty-state">
    <i class="fas fa-at"></i>
    <h3>Verified Domain Required</h3>
    <p>Add and verify a domain before creating sender identities.</p>
    <a href="/domains" class="btn btn-primary"><i class="fas fa-globe"></i> Go to Domains</a>
  </div>
</div>
<% } else if (identities.length === 0) { %>
<div class="card animate-in delay-1">
  <div class="empty-state">
    <i class="fas fa-at"></i>
    <h3>No Sender Identities</h3>
    <p>Create a sender identity to define who emails appear to come from.</p>
    <button class="btn btn-primary" onclick="openModal('addIdentityModal')"><i class="fas fa-plus"></i> Add Sender</button>
  </div>
</div>
<% } else { %>
<div class="card animate-in delay-1">
  <div class="card-body" style="padding: 0;">
    <div class="table-wrap" style="border: none; border-radius: 0;">
      <table>
        <thead><tr><th>Email</th><th>Display Name</th><th>Domain</th><th>Reply-To</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody>
          <% identities.forEach(function(ident) { %>
          <tr>
            <td><strong><%= ident.email %></strong></td>
            <td><%= ident.display_name %></td>
            <td><%= ident.domain_name %></td>
            <td><%= ident.reply_to || '-' %></td>
            <td><span class="badge badge-<%= ident.enabled ? 'success' : 'danger' %>"><%= ident.enabled ? 'Enabled' : 'Disabled' %></span></td>
            <td style="display: flex; gap: 0.4rem;">
              <form method="POST" action="/identities/<%= ident._id %>/toggle" style="display:inline;">
                <button type="submit" class="btn btn-ghost btn-sm"><i class="fas fa-power-off"></i></button>
              </form>
              <form method="POST" action="/identities/<%= ident._id %>/delete" style="display:inline;" onsubmit="return confirm('Delete?')">
                <button type="submit" class="btn btn-ghost btn-sm" style="color: var(--danger);"><i class="fas fa-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<% } %>

<!-- Add Identity Modal -->
<div class="modal-overlay" id="addIdentityModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add Sender Identity</span>
      <button class="modal-close" onclick="closeModal('addIdentityModal')">&times;</button>
    </div>
    <form method="POST" action="/identities/add">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Domain</label>
          <select name="domain_id" class="form-select" required>
            <% domains.forEach(function(d) { %>
            <option value="<%= d._id %>"><%= d.domain %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" name="email" class="form-control" placeholder="hello@yourdomain.com" required>
        </div>
        <div class="form-group">
          <label class="form-label">Display Name</label>
          <input type="text" name="display_name" class="form-control" placeholder="My Business">
        </div>
        <div class="form-group">
          <label class="form-label">Reply-To (optional)</label>
          <input type="email" name="reply_to" class="form-control" placeholder="support@yourdomain.com">
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('addIdentityModal')">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Create Sender</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
