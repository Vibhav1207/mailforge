<%- include('partials/head', { title: 'Settings' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-cog"></i> Settings</h2>
</div>

<div style="max-width: 600px;">
  <div class="card animate-in delay-1">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;">Workspace</h3>
    </div>
    <div class="card-body">
      <form method="POST" action="/settings/update">
        <div class="form-group">
          <label class="form-label">Workspace Name</label>
          <input type="text" name="name" class="form-control" value="<%= workspace.name %>">
        </div>
        <div class="form-group">
          <label class="form-label">Slug</label>
          <input type="text" class="form-control" value="<%= workspace.slug %>" disabled>
          <div class="form-hint">Cannot be changed</div>
        </div>
        <div class="form-group">
          <label class="form-label">Plan</label>
          <input type="text" class="form-control" value="<%= workspace.plan %>" disabled>
          <div class="form-hint">Unlimited sending — no restrictions</div>
        </div>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Save Changes</button>
      </form>
    </div>
  </div>

  <div class="card animate-in delay-2" style="margin-top: 1rem;">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;">Account</h3>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label">Email</label>
        <input type="text" class="form-control" value="<%= user.email %>" disabled>
      </div>
      <div class="form-group">
        <label class="form-label">Name</label>
        <input type="text" class="form-control" value="<%= user.name %>" disabled>
      </div>
      <div class="form-group">
        <label class="form-label">Member Since</label>
        <input type="text" class="form-control" value="<%= user.created_at ? new Date(user.created_at).toLocaleDateString() : '' %>" disabled>
      </div>
    </div>
  </div>

  <div class="card animate-in delay-3" style="margin-top: 1rem;">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;">Usage</h3>
    </div>
    <div class="card-body">
      <div style="display: flex; justify-content: space-between; font-size: 0.85rem; margin-bottom: 0.5rem;">
        <span>Email Sending</span>
        <span style="color: var(--accent); font-weight: 600;">Unlimited</span>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar-fill" style="width: 0%;"></div>
      </div>
      <p class="form-hint" style="margin-top: 0.5rem;">No email sending limits. Send as many emails as you need.</p>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
