<%- include('partials/head', { title: 'API Documentation' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-code"></i> API Documentation</h2>
</div>

<!-- Quick Start -->
<div class="card animate-in delay-1">
  <div class="card-header">
    <h3 style="font-size: 0.95rem; font-weight: 700;">Quick Start</h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">
      Send your first email with a simple API call. All you need is an API key and a verified domain.
    </p>
    <div class="alert alert-info">
      <i class="fas fa-info-circle"></i>
      <span>Base URL: <code>https://api.yourservice.com</code> · Authentication: Bearer token in Authorization header</span>
    </div>
  </div>
</div>

<!-- Send Email -->
<div class="card animate-in delay-2" style="margin-top: 1rem;">
  <div class="card-header">
    <h3 style="font-size: 0.95rem; font-weight: 700;">
      <span class="badge badge-success" style="margin-right: 0.5rem;">POST</span>
      /v1/emails
    </h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Send an email. The email is validated, queued, and sent asynchronously.</p>

    <h4 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Request Body</h4>
    <div class="table-wrap" style="margin-bottom: 1.5rem;">
      <table>
        <thead><tr><th>Parameter</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
        <tbody>
          <tr><td><code>from</code></td><td>string</td><td>Yes</td><td>Sender email (must be from a verified domain)</td></tr>
          <tr><td><code>to</code></td><td>string[]</td><td>Yes</td><td>Recipient email addresses</td></tr>
          <tr><td><code>subject</code></td><td>string</td><td>Yes*</td><td>Email subject line (*or use template_id)</td></tr>
          <tr><td><code>html</code></td><td>string</td><td>Yes*</td><td>HTML body (*or use text or template_id)</td></tr>
          <tr><td><code>text</code></td><td>string</td><td>No</td><td>Plain text body</td></tr>
          <tr><td><code>cc</code></td><td>string[]</td><td>No</td><td>CC recipients</td></tr>
          <tr><td><code>bcc</code></td><td>string[]</td><td>No</td><td>BCC recipients</td></tr>
          <tr><td><code>reply_to</code></td><td>string</td><td>No</td><td>Reply-To address</td></tr>
          <tr><td><code>template_id</code></td><td>string</td><td>No</td><td>Use a saved template</td></tr>
          <tr><td><code>variables</code></td><td>object</td><td>No</td><td>Template variables</td></tr>
          <tr><td><code>tags</code></td><td>string[]</td><td>No</td><td>Tags for categorization</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Code Examples -->
    <h4 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem;">Code Examples</h4>

    <!-- cURL -->
    <div class="terminal" style="margin-bottom: 1rem;">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">cURL</span>
        <button class="btn btn-ghost btn-sm" onclick="copyToClipboard(document.getElementById('curlCode').textContent, this)"><i class="fas fa-copy"></i></button>
      </div>
      <div class="terminal-body" id="curlCode">curl -X POST https://api.yourservice.com/v1/emails \
  -H "Authorization: Bearer sk_live_your_api_key" \
  -H "Content-Type: application/json" \
  -d '{
    "from": "hello@yourdomain.com",
    "to": ["customer@example.com"],
    "subject": "Welcome!",
    "html": "<h1>Welcome to our platform</h1><p>Thanks for signing up.</p>"
  }'</div>
    </div>

    <!-- JavaScript -->
    <div class="terminal" style="margin-bottom: 1rem;">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">JavaScript (Node.js)</span>
        <button class="btn btn-ghost btn-sm" onclick="copyToClipboard(document.getElementById('jsCode').textContent, this)"><i class="fas fa-copy"></i></button>
      </div>
      <div class="terminal-body" id="jsCode">const response = await fetch("https://api.yourservice.com/v1/emails", {
  method: "POST",
  headers: {
    "Authorization": "Bearer sk_live_your_api_key",
    "Content-Type": "application/json"
  },
  body: JSON.stringify({
    from: "hello@yourdomain.com",
    to: ["customer@example.com"],
    subject: "Welcome!",
    html: "&lt;h1&gt;Welcome to our platform&lt;/h1&gt;"
  })
});

const data = await response.json();
console.log(data); // { id: "email_xxx", status: "queued" }</div>
    </div>

    <!-- Python -->
    <div class="terminal" style="margin-bottom: 1rem;">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">Python</span>
        <button class="btn btn-ghost btn-sm" onclick="copyToClipboard(document.getElementById('pyCode').textContent, this)"><i class="fas fa-copy"></i></button>
      </div>
      <div class="terminal-body" id="pyCode">import requests

response = requests.post(
    "https://api.yourservice.com/v1/emails",
    headers={
        "Authorization": "Bearer sk_live_your_api_key",
        "Content-Type": "application/json"
    },
    json={
        "from": "hello@yourdomain.com",
        "to": ["customer@example.com"],
        "subject": "Welcome!",
        "html": "&lt;h1&gt;Welcome to our platform&lt;/h1&gt;"
    }
)

print(response.json())</div>
    </div>

    <!-- PHP -->
    <div class="terminal" style="margin-bottom: 1rem;">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">PHP</span>
        <button class="btn btn-ghost btn-sm" onclick="copyToClipboard(document.getElementById('phpCode').textContent, this)"><i class="fas fa-copy"></i></button>
      </div>
      <div class="terminal-body" id="phpCode">$ch = curl_init("https://api.yourservice.com/v1/emails");
curl_setopt_array($ch, [
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_POST => true,
    CURLOPT_HTTPHEADER => [
        "Authorization: Bearer sk_live_your_api_key",
        "Content-Type: application/json"
    ],
    CURLOPT_POSTFIELDS => json_encode([
        "from" => "hello@yourdomain.com",
        "to" => ["customer@example.com"],
        "subject" => "Welcome!",
        "html" => "&lt;h1&gt;Welcome&lt;/h1&gt;"
    ])
]);

$response = curl_exec($ch);
echo $response;</div>
    </div>

    <!-- Response -->
    <h4 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.5rem;">Response</h4>
    <div class="terminal">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">200 OK</span>
      </div>
      <div class="terminal-body">{
  "id": "email_a1b2c3d4e5f6...",
  "status": "queued",
  "from": "hello@yourdomain.com",
  "to": ["customer@example.com"],
  "subject": "Welcome!",
  "created_at": "2026-08-31T12:00:00.000Z"
}</div>
    </div>
  </div>
</div>

<!-- Get Email -->
<div class="card animate-in delay-3" style="margin-top: 1rem;">
  <div class="card-header">
    <h3 style="font-size: 0.95rem; font-weight: 700;">
      <span class="badge badge-info" style="margin-right: 0.5rem;">GET</span>
      /v1/emails/:id
    </h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;">Retrieve email details and event timeline by email ID.</p>

    <div class="terminal">
      <div class="terminal-header">
        <div class="terminal-dots"><span></span><span></span><span></span></div>
        <span class="terminal-title">cURL</span>
        <button class="btn btn-ghost btn-sm" onclick="copyToClipboard(this.closest('.terminal').querySelector('.terminal-body').textContent, this)"><i class="fas fa-copy"></i></button>
      </div>
      <div class="terminal-body">curl https://api.yourservice.com/v1/emails/email_a1b2c3d4... \
  -H "Authorization: Bearer sk_live_your_api_key"</div>
    </div>
  </div>
</div>

<!-- List Emails -->
<div class="card animate-in delay-4" style="margin-top: 1rem;">
  <div class="card-header">
    <h3 style="font-size: 0.95rem; font-weight: 700;">
      <span class="badge badge-info" style="margin-right: 0.5rem;">GET</span>
      /v1/emails
    </h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.5rem;">List emails in your workspace. Supports <code>limit</code> (max 100) and <code>offset</code> query parameters.</p>
  </div>
</div>

<!-- Health -->
<div class="card animate-in delay-5" style="margin-top: 1rem;">
  <div class="card-header">
    <h3 style="font-size: 0.95rem; font-weight: 700;">
      <span class="badge badge-success" style="margin-right: 0.5rem;">GET</span>
      /v1/health
    </h3>
  </div>
  <div class="card-body">
    <p style="font-size: 0.85rem; color: var(--text-muted);">Health check endpoint. Returns <code>{ "status": "ok" }</code> without authentication.</p>
  </div>
</div>

<%- include('partials/footer') %>
