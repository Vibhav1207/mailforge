<%- include('partials/head', { title: 'Domains' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-globe"></i> Domains</h2>
  <button class="btn btn-primary" onclick="openModal('addDomainModal')"><i class="fas fa-plus"></i> Add Domain</button>
</div>

<% if (domains.length === 0) { %>
<div class="card animate-in delay-1">
  <div class="empty-state">
    <i class="fas fa-globe"></i>
    <h3>No Domains Yet</h3>
    <p>Add your first domain to start sending emails from your own address.</p>
    <button class="btn btn-primary" onclick="openModal('addDomainModal')"><i class="fas fa-plus"></i> Add Domain</button>
  </div>
</div>
<% } else { %>
<div class="domain-grid animate-in delay-1">
  <% domains.forEach(function(d) { %>
  <a href="/domains/<%= d._id %>" class="domain-card card">
    <div class="card-body">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
        <span style="font-weight: 700; font-size: 1rem;"><%= d.domain %></span>
        <span class="badge badge-<%= d.status === 'verified' ? 'success' : d.status === 'failed' ? 'danger' : 'info' %>">
          <% if (d.status === 'verified') { %>✓ Verified<% } else if (d.status === 'verifying') { %>⏳ Verifying<% } else if (d.status === 'failed') { %>✗ Failed<% } else { %>Pending<% } %>
        </span>
      </div>
      <div style="font-size: 0.78rem; color: var(--text-muted);">
        Added <%= formatDate(d.created_at) %>
        <% if (d.verified_at) { %> · Verified <%= formatDate(d.verified_at) %><% } %>
      </div>
    </div>
  </a>
  <% }); %>
</div>
<% } %>

<!-- Add Domain Modal -->
<div class="modal-overlay" id="addDomainModal">
  <div class="modal">
    <div class="modal-header">
      <span class="modal-title">Add Domain</span>
      <button class="modal-close" onclick="closeModal('addDomainModal')">&times;</button>
    </div>
    <form method="POST" action="/domains/add">
      <div class="modal-body">
        <div class="form-group">
          <label class="form-label">Domain Name</label>
          <input type="text" name="domain" class="form-control" placeholder="mybusiness.com" required>
          <div class="form-hint">Enter your root domain (e.g., example.com)</div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-ghost" onclick="closeModal('addDomainModal')">Cancel</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-plus"></i> Add Domain</button>
      </div>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
