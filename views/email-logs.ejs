<%- include('partials/head', { title: 'Emails' }) %>

<div class="page-header animate-in">
  <h2 class="page-title"><i class="fas fa-envelope"></i> Emails</h2>
  <div style="display: flex; gap: 0.5rem;">
    <a href="/emails" class="btn btn-ghost btn-sm <%= !statusFilter ? 'active' : '' %>" style="<%= !statusFilter ? 'border-color: var(--accent); color: var(--accent);' : '' %>">All</a>
    <a href="/emails?status=delivered" class="btn btn-ghost btn-sm" style="<%= statusFilter === 'delivered' ? 'border-color: var(--success); color: var(--success);' : '' %>">Delivered</a>
    <a href="/emails?status=failed" class="btn btn-ghost btn-sm" style="<%= statusFilter === 'failed' ? 'border-color: var(--danger); color: var(--danger);' : '' %>">Failed</a>
    <a href="/emails?status=queued" class="btn btn-ghost btn-sm" style="<%= statusFilter === 'queued' ? 'border-color: var(--info); color: var(--info);' : '' %>">Queued</a>
  </div>
</div>

<div class="card animate-in delay-1">
  <div class="card-body" style="padding: 0;">
    <% if (emails.length === 0) { %>
    <div class="empty-state">
      <i class="fas fa-envelope-open"></i>
      <h3>No Emails Found</h3>
      <p><%= statusFilter ? 'No emails with this status.' : 'Send your first email via the API.' %></p>
    </div>
    <% } else { %>
    <div class="table-wrap" style="border: none; border-radius: 0;">
      <table>
        <thead>
          <tr><th>ID</th><th>From</th><th>To</th><th>Subject</th><th>Status</th><th>Created</th></tr>
        </thead>
        <tbody>
          <% emails.forEach(function(e) { %>
          <tr class="log-row-clickable" onclick="window.location='/emails/<%= e.email_id %>'">
            <td><code style="font-size: 0.75rem; color: var(--text-muted);"><%= e.email_id.slice(0, 16) %>...</code></td>
            <td><%= e.from_email %></td>
            <td><%= e.to && e.to[0] ? (e.to[0].length > 25 ? e.to[0].slice(0,25)+'...' : e.to[0]) : '-' %></td>
            <td><%= e.subject ? (e.subject.length > 35 ? e.subject.slice(0,35)+'...' : e.subject) : '-' %></td>
            <td>
              <span class="badge badge-<%= e.status === 'delivered' ? 'success' : e.status === 'failed' ? 'danger' : 'info' %>">
                <%= e.status %>
              </span>
            </td>
            <td><%= formatDate(e.created_at) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div style="padding: 1rem; display: flex; justify-content: center; gap: 0.5rem;">
      <% if (page > 1) { %>
      <a href="/emails?page=<%= page - 1 %>&status=<%= statusFilter %>" class="btn btn-ghost btn-sm"><i class="fas fa-chevron-left"></i></a>
      <% } %>
      <span style="padding: 0.3rem 0.7rem; font-size: 0.82rem; color: var(--text-muted);">Page <%= page %> of <%= totalPages %> (<%= total %> total)</span>
      <% if (page < totalPages) { %>
      <a href="/emails?page=<%= page + 1 %>&status=<%= statusFilter %>" class="btn btn-ghost btn-sm"><i class="fas fa-chevron-right"></i></a>
      <% } %>
    </div>
    <% } %>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
