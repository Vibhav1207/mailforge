<%- include('partials/head', { title: 'API Key Created' }) %>

<div style="max-width: 600px; margin: 3rem auto;">
  <div class="card animate-in">
    <div class="card-body" style="text-align: center; padding: 2.5rem;">
      <div style="font-size: 3rem; margin-bottom: 1rem;">🔑</div>
      <h2 style="font-size: 1.3rem; font-weight: 700; margin-bottom: 0.5rem;">API Key Created</h2>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">
        Your key <strong><%= name %></strong> has been created. Copy it now — it won't be shown again.
      </p>

      <div class="alert alert-warning" style="text-align: left; margin-bottom: 1rem;">
        <i class="fas fa-exclamation-triangle"></i>
        <span><strong>Store this key securely.</strong> It cannot be retrieved after closing this page.</span>
      </div>

      <div style="background: var(--bg-input); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1.5rem; word-break: break-all;">
        <code style="font-size: 0.85rem; color: var(--accent);"><%= rawKey %></code>
      </div>

      <div style="display: flex; gap: 0.75rem; justify-content: center;">
        <button class="btn btn-primary" onclick="copyToClipboard('<%= rawKey %>', this)"><i class="fas fa-copy"></i> Copy Key</button>
        <a href="/api-keys" class="btn btn-ghost">Back to API Keys</a>
      </div>

      <div style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); text-align: left;">
        <h4 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 0.75rem;">Quick Start</h4>
        <div class="terminal">
          <div class="terminal-header">
            <div class="terminal-dots"><span></span><span></span><span></span></div>
            <span class="terminal-title">cURL</span>
          </div>
          <div class="terminal-body">
            <span style="color: var(--text-muted);">$</span> curl -X POST https://api.yourservice.com/v1/emails \<br>
            &nbsp;&nbsp;-H "Authorization: Bearer <span style="color: var(--accent);"><%= rawKey.slice(0, 12) %>..."</span> \<br>
            &nbsp;&nbsp;-H "Content-Type: application/json" \<br>
            &nbsp;&nbsp;-d '{"from":"hello@yourdomain.com","to":["user@example.com"],"subject":"Hello","html":"<h1>Hello</h1>"}'
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
