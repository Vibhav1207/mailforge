<%- include('partials/head', { title: 'Email Detail' }) %>

<div class="page-header animate-in">
  <div>
    <a href="/emails" style="color: var(--text-muted); font-size: 0.85rem;"><i class="fas fa-arrow-left"></i> Emails</a>
    <h2 class="page-title" style="margin-top: 0.25rem;">Email Details</h2>
  </div>
  <span class="badge badge-<%= email.status === 'delivered' ? 'success' : email.status === 'failed' ? 'danger' : 'info' %>" style="font-size: 0.82rem; padding: 0.4rem 0.9rem;">
    <%= email.status %>
  </span>
</div>

<div style="display: grid; grid-template-columns: 1fr 350px; gap: 1rem;">
  <!-- Email Content -->
  <div class="card animate-in delay-1">
    <div class="card-header">
      <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-envelope" style="color: var(--accent); margin-right: 0.5rem;"></i> Email Content</h3>
    </div>
    <div class="card-body">
      <div class="log-detail-field">
        <div class="form-label">ID</div>
        <div class="log-detail-value"><code><%= email.email_id %></code></div>
      </div>
      <div class="log-detail-field">
        <div class="form-label">From</div>
        <div class="log-detail-value"><%= email.from_name ? email.from_name + ' <' + email.from_email + '>' : email.from_email %></div>
      </div>
      <div class="log-detail-field">
        <div class="form-label">To</div>
        <div class="log-detail-value"><%= email.to ? email.to.join(', ') : '-' %></div>
      </div>
      <% if (email.cc && email.cc.length) { %>
      <div class="log-detail-field">
        <div class="form-label">CC</div>
        <div class="log-detail-value"><%= email.cc.join(', ') %></div>
      </div>
      <% } %>
      <div class="log-detail-field">
        <div class="form-label">Subject</div>
        <div class="log-detail-value"><%= email.subject %></div>
      </div>
      <% if (email.reply_to) { %>
      <div class="log-detail-field">
        <div class="form-label">Reply-To</div>
        <div class="log-detail-value"><%= email.reply_to %></div>
      </div>
      <% } %>
      <div class="log-detail-field">
        <div class="form-label">Provider</div>
        <div class="log-detail-value"><%= email.provider || 'smtp' %></div>
      </div>
      <% if (email.last_error) { %>
      <div class="log-detail-field">
        <div class="form-label">Error</div>
        <div class="log-detail-value" style="color: var(--danger);"><%= email.last_error %></div>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Timeline -->
  <div>
    <div class="card animate-in delay-2">
      <div class="card-header">
        <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-clock" style="color: var(--accent); margin-right: 0.5rem;"></i> Timeline</h3>
      </div>
      <div class="card-body">
        <div class="log-detail-field">
          <div class="form-label">Created</div>
          <div class="log-detail-value"><%= formatDateTime(email.created_at) %></div>
        </div>
        <% if (email.sent_at) { %>
        <div class="log-detail-field">
          <div class="form-label">Sent</div>
          <div class="log-detail-value"><%= formatDateTime(email.sent_at) %></div>
        </div>
        <% } %>
        <% if (email.delivered_at) { %>
        <div class="log-detail-field">
          <div class="form-label">Delivered</div>
          <div class="log-detail-value"><%= formatDateTime(email.delivered_at) %></div>
        </div>
        <% } %>

        <div style="margin-top: 1rem;">
          <div class="form-label" style="margin-bottom: 0.75rem;">Events</div>
          <% events.forEach(function(ev) { %>
          <div style="display: flex; gap: 0.75rem; margin-bottom: 0.75rem; align-items: flex-start;">
            <div style="width: 8px; height: 8px; border-radius: 50%; background: <%= ev.event === 'delivered' ? 'var(--success)' : ev.event === 'failed' ? 'var(--danger)' : 'var(--accent)' %>; margin-top: 0.35rem; flex-shrink: 0;"></div>
            <div>
              <div style="font-size: 0.82rem; font-weight: 600;"><%= ev.event %></div>
              <div style="font-size: 0.72rem; color: var(--text-muted);"><%= formatDateTime(ev.timestamp) %></div>
            </div>
          </div>
          <% }); %>
        </div>
      </div>
    </div>

    <% if (email.tags && email.tags.length) { %>
    <div class="card animate-in delay-3" style="margin-top: 1rem;">
      <div class="card-header">
        <h3 style="font-size: 0.9rem; font-weight: 600;"><i class="fas fa-tags" style="color: var(--accent); margin-right: 0.5rem;"></i> Tags</h3>
      </div>
      <div class="card-body">
        <% email.tags.forEach(function(tag) { %>
        <span class="badge badge-info" style="margin-right: 0.3rem;"><%= tag %></span>
        <% }); %>
      </div>
    </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
