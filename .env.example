# ==============================================================================
# MailForge - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env.local for local development or add these values in Netlify.

# ------------------------------------------------------------------------------
# 1. APPLICATION URL (Use your production Netlify URL)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-site.netlify.app

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS DATABASE (Required for Netlify Functions)
# ------------------------------------------------------------------------------
# Connect your MongoDB Atlas cluster (allow Netlify Functions to access it in Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=freesend

# ------------------------------------------------------------------------------
# 3. CREDENTIAL & DKIM ENCRYPTION KEY (Required for Production)
# ------------------------------------------------------------------------------
# 64-character hex string (32 bytes) for authenticated AES-256-GCM encryption of
# user SMTP credentials and domain DKIM private keys.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. CRON WORKER SECRET (For the protected HTTP worker route)
# ------------------------------------------------------------------------------
# Netlify uses the scheduled campaign-worker function; keep this for manual or external triggers.
CRON_SECRET=random_32_character_string_for_cron_jobs_12345

# ------------------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (Google Authentication & Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDiQAzq67qV5syXxPqjpgvKHEpuAj26bKs
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-8413591175-7c92a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=studio-8413591175-7c92a
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=studio-8413591175-7c92a.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=373987533305
NEXT_PUBLIC_FIREBASE_APP_ID=1:373987533305:web:cfd62c576fa0df802c9d28

# ------------------------------------------------------------------------------
# 6. SYSTEM DEFAULT SENDER (Fallback)
# ------------------------------------------------------------------------------
FROM_NAME="MailForge Dispatcher"
FROM_EMAIL=noreply@yourdomain.com
EMAIL_FROM=noreply@yourdomain.com

# ------------------------------------------------------------------------------
# 7. OPTIONAL ENVIRONMENT SMTP / GMAIL APP PASSWORD
# ------------------------------------------------------------------------------
# Note: Users can configure their own SMTP or Gmail in Settings on the web UI.
# If you want a platform-level fallback:
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ------------------------------------------------------------------------------
# 8. BATCH LIMITS
# ------------------------------------------------------------------------------
BATCH_SIZE=50
BATCH_DELAY_MS=2000
